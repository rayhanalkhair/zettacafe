{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "zettacafe": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "zc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/playfair-display/index.css",
              "node_modules/@fontsource-variable/work-sans/index.css",
              "src/styles.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": ["src/styles"]
            },
            "define": {
              "DEV_TOOLS": "true",
              "API_URL": "\"\""
            },
            "loader": {
              ".graphql": "text"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "760kB",
                  "maximumError": "900kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/environments/environment.ts",
                  "with": "src/environments/environment.production.ts"
                }
              ],
              "define": {
                "DEV_TOOLS": "false",
                "API_URL": "\"\""
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "zettacafe:build:production"
            },
            "development": {
              "buildTarget": "zettacafe:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "zettacafe:build:development",
            "runner": "vitest",
            "providersFile": "src/test-providers.ts",
            "coverageExclude": [
              "legacy-src/**",
              "e2e/**",
              "scripts/**",
              "**/*.spec.ts",
              "src/test-providers.ts"
            ],
            "coverageReporters": ["text-summary", "lcov"],
            "coverageThresholds": {
              "statements": 70,
              "branches": 70,
              "functions": 70,
              "lines": 70
            },
            "runnerConfig": "vitest-base.config.mjs"
          }
        }
      }
    }
  }
}

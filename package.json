{
  "name": "zettacafe",
  "version": "2.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "ng test --watch=false",
    "test:coverage": "ng test --watch=false --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"src/**/*.scss\"",
    "stylelint:fix": "stylelint \"src/**/*.scss\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "i18n:check": "node scripts/check-i18n.mjs",
    "verify": "npm run lint && npm run stylelint && npm run format:check && npm run i18n:check && npm run contrast:check && npm run codegen:check && npm run typecheck && npm run test:unit && npm run build && npm run bundle:check",
    "prepare": "husky",
    "contrast:check": "node scripts/check-contrast.mjs",
    "contrast:table": "node scripts/check-contrast.mjs --table",
    "bundle:check": "node scripts/check-bundle.mjs",
    "codegen": "graphql-codegen --config codegen.mjs",
    "codegen:check": "npm run codegen && git diff --exit-code -- src/server/generated src/app/core/graphql/generated \"src/app/features/**/graphql.generated.ts\""
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.7",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@apollo/client": "^4.3.1",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/work-sans": "^5.3.0",
    "@graphql-tools/schema": "^10.1.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "apollo-angular": "^14.2.0",
    "graphql": "^16.14.2",
    "idb": "^8.0.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.0",
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.4.1",
    "@graphql-codegen/typed-document-node": "^7.1.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@graphql-codegen/typescript-resolvers": "^6.1.0",
    "@playwright/test": "^1.63.0",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "^22.5.0",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^17.5.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.8.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.0.8"
  },
  "description": "Cafe ordering app: browse an Indonesian menu, order, and manage recipes and stock.",
  "license": "MIT",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
